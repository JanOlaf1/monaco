{
  "name": "monaco",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-runtime-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-runtime-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/copy-runtime-assets.mjs",
    "test:e2e": "playwright test",
    "build:e2e-cloud": "node scripts/build-cloud-e2e.mjs",
    "test:e2e:cloud": "firebase emulators:exec --only auth,firestore --project demo-koodaamo \"playwright test -c playwright.cloud.config.ts\"",
    "test:rules": "firebase emulators:exec --only auth,firestore --project demo-koodaamo \"vitest run --config vitest.emulators.config.mts\""
  },
  "dependencies": {
    "@firebase/util": "1.15.3",
    "acorn": "^8.19.0",
    "firebase": "^13.2.0",
    "lucide-react": "^1.71.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.6",
    "pyodide": "314.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
