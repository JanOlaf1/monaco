{
  "apphosting": {
    "backendId": "monaco",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9095 },
    "firestore": { "host": "127.0.0.1", "port": 8085 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
